# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables.

# --- Model: set ONE of these keys ------------------------------------------
OPENAI_API_KEY= 
# ANTHROPIC_API_KEY=

# Optional. Picks the provider when both keys are set: openai | anthropic
# LLM_PROVIDER=openai

# Optional. Defaults: gpt-5-mini (OpenAI), claude-sonnet-5 (Anthropic).
# The model must accept images (for screenshot OCR).
# LLM_MODEL=

# Optional. Azure OpenAI or another OpenAI-compatible endpoint. For Azure, use your
# Azure key as OPENAI_API_KEY and your deployment name as LLM_MODEL.
# OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/

# --- Protection ---------------------------------------------------------------
# Optional but recommended on a public URL: the UI asks for this code before the
# agents run, so strangers can't spend your API credits.
# ACCESS_CODE=
